module router_top(
input clk,
input rst,
input pkt_vld,
input [7:0]data_in,
input rd_en0,
input rd_en1,
input rd_en2,
output [7:0]dout0,
output [7:0]dout1,
output [7:0]dout2,
output vld_out0,
output vld_out1,
output vld_out2,
output err,
output busy
);

wire [2:0]wrt_en;
wire [7:0]dout;
wire dtct_add,lfd_st, ld_st, laf_st, full_st, wrt_en_reg, rst_int_reg;
wire prt, low_pkt_vld;
wire fifo_full, empt0, empt1, empt2;
wire full_0, full_1, full_2;
wire sft_rst_0, sft_rst_1, sft_rst_2;

router_fsm FSM(
.clk(clk),
.rst(rst),
.pkt_vld(pkt_vld),
.data_in(data_in[1:0]),
.fifo_full(fifo_full),
.fifo_empt_0(empt_0),
.fifo_empt_1(empt_1),
.fifo_empt_2(empt_2),
.sft_rst_0(sft_rst_0),
.sft_rst_1(sft_rst_1),
.sft_rst_2(sft_rst_2),
.prt(prt),
.low_pkt_vld(low_pkt_vld),
.wrt_en_reg(wrt_en_reg),
.dtct_add(dtct_add),
.lfd_st(lfd_st),
.ld_st(ld_st),
.laf_st(laf_st),
.full_st(full_st),
.rst_int_reg(rst_int_reg),
.busy(busy)
);


router_sync SYNC(
.clk(clk),
.rst(rst),
.data_in(data_in[1:0]),
.dtct_add(dtct_add),
.full_0(full_0),
.full_1(full_1),
.full_2(full_2),
.empt_0(empt_0),
.empt_1(empt_1),
.empt_2(empt_2),
.wrt_en_reg(wrt_en_reg),
.rd_en0(rd_en0),
.rd_en1(rd_en1),
.rd_en2(rd_en2),
.wrt_en(wrt_en),
.fifo_full(fifo_full),
.vld_out0(vld_out0),
.vld_out1(vld_out1),
.vld_out2(vld_out2),
.sft_rst_0(sft_rst_0),
.sft_rst_1(sft_rst_1),
.sft_rst_2()
);

router_reg REG(
.clk(clk),
.rst(rst),
.pkt_vld(pkt_vld),
.data_in(data_in),
.fifo_full(fifo_full),
.rst_int_reg(rst_int_reg),
.dtct_add(dtct_add),
.ld_st(ld_st),
.laf_st(laf_st),
.full_st(full_st),
.lfd_st(lfd_st),
.dout(dout),
.err(err),
.prt(prt),
.low_pkt_vld(low_pkt_vld)
);

router_fifo FIFO_0(
.clk(clk),
.rst(rst),
.sft_rst(sft_rst_0),
.wrt_en(wrt_en[0]),
.rd_en(rd_en_0),
.lfd_st(lfd_st),
.data_in(dout),
.dout(dout_0),
.full(full_0),
.empt(empt_0)
);

router_fifo FIFO_1(
.clk(clk),
.rst(rst),
.sft_rst(sft_rst_1),
.wrt_en(wrt_en[1]),
.rd_en(rd_en_1),
.lfd_st(lfd_st),
.data_in(dout),
.dout(dout_1),
.full(full_1),
.empt(empt_1)
);

router_fifo FIFO_2(
.clk(clk),
.rst(rst),
.sft_rst(sft_rst_2),
.wrt_en(wrt_en[2]),
.rd_en(rd_en_2),
.lfd_st(lfd_st),
.data_in(dout),
.dout(dout_2),
.full(full_2),
.empt(empt_2)
);


endmodule
 
